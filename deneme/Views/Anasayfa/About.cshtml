
@{
    ViewBag.Title = "About";
    Layout = "~/Views/Shared/AnasayfaLayout.cshtml";
}


<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 text-center">
                <div class="breadcrumb-text">
                    <p>Doğal & Organik</p>
                    <h1>Hakkımızda</h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end breadcrumb section -->
<!-- featured section -->
<div class="feature-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div class="featured-text">
                    <h2 class="pb-3">Neden Bizi Tercih Etmelisiniz?</h2>
                    <div class="row">
                        <div class="col-lg-6 col-md-6 mb-4 mb-md-5">
                            <div class="list-box d-flex">
                                <div class="list-icon">
                                    <i class="fas fa-shipping-fast"></i>
                                </div>
                                <div class="content">
                                    <h3>Eve Teslimat</h3>
                                    <p>Siparişlerinizi güvenle verin, doğal lezzetleri kapınıza kadar getirelim.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 mb-5 mb-md-5">
                            <div class="list-box d-flex">
                                <div class="list-icon">
                                    <i class="fas fa-money-bill-alt"></i>
                                </div>
                                <div class="content">
                                    <h3>En İyi Fiyat</h3>
                                    <p>Kaliteli ve doğal ürünleri en uygun fiyatlarla sizlere sunuyoruz.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 mb-5 mb-md-5">
                            <div class="list-box d-flex">
                                <div class="list-icon">
                                    <i class="fas fa-briefcase"></i>
                                </div>
                                <div class="content">
                                    <h3>Özel Paket</h3>
                                    <p>Ürünlerimiz, tazeliğini koruyacak şekilde özenle paketlenir.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <div class="list-box d-flex">
                                <div class="list-icon">
                                    <i class="fas fa-sync-alt"></i>
                                </div>
                                <div class="content">
                                    <h3>Hızlı İade</h3>
                                    <p>Memnun kalmadığınız ürünleri kolayca ve hızlı bir şekilde iade edebilirsiniz.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end featured section -->
<!-- shop banner -->

<section class="shop-banner">
    <div class="container">
        <h3>Rize ve Gaziantep’te <br> Doğal Üretim Yapıyoruz!</h3>
        <p>
            Ürünlerimizi geleneksel yöntemlerle, tamamen doğal ve katkısız olarak üretiyoruz.
            Aynı gün kargo hizmetimiz ile siparişlerinizi hızlıca ulaştırıyoruz.
            Toplu alımlar için bizimle iletişime geçebilirsiniz.
        </p>
        <a href="Contact" class="cart-btn btn-lg">İletişime Geçin</a>
    </div>
</section>

		</div>
	</div>
<!-- end team section -->
<!-- testimonail-section -->
<div class="testimonail-section mt-150 mb-150">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1 text-center">
                <div class="testimonial-sliders">
                    <div class="single-testimonial-slider">
                        <div class="client-avater">
                            <img src="~/assets/img/avaters/avatar1.1.png" alt="">
                        </div>
                        <div class="client-meta">
                            <h3>Fatma Karaman<span>Üreticimiz</span></h3>
                            <p class="testimonial-body">
                                " yıllardır geleneksel yöntemlerle doğal köy ürünleri üreten deneyimli bir çiftçidir. Doğaya ve sağlıklı beslenmeye olan tutkusu ile katkısız, doğal ve lezzetli ürünler üretmeye devam etmektedir. Tarım ve hayvancılıkla iç içe geçen yaşamında, en kaliteli ürünleri sofralarınıza ulaştırmayı amaçlamaktadır. Onun emeğiyle hazırlanan doğal lezzetleri keşfedin! "
                            </p>
                            <div class="last-icon">
                                <i class="fas fa-quote-right"></i>
                            </div>
                        </div>
                    </div>
                    <div class="single-testimonial-slider">
                        <div class="client-avater">
                            <img src="~/assets/img/avaters/avatar2.2.png" alt="">
                        </div>
                        <div class="client-meta">
                            <h3>Güler Ermicik <span>Üreticimiz</span></h3>
                            <p class="testimonial-body">
                                " yıllardır doğal ve organik üretime gönül vermiş bir çiftçidir. Antep’nin verimli topraklarında, geleneksel yöntemleri modern bilgiyle harmanlayarak katkısız ve sağlıklı köy ürünleri üretmektedir. Doğaya duyduğu sevgi ve titiz emeğiyle, en taze ve doğal ürünleri sofralarınıza ulaştırmak için çalışmaktadır. Onun el emeğiyle üretilen doğal lezzetleri keşfedin! "
                            </p>
                            <div class="last-icon">
                                <i class="fas fa-quote-right"></i>
                            </div>
                        </div>
                    </div>
                    <div class="single-testimonial-slider">
                        <div class="client-avater">
                            <img src="~/assets/img/avaters/avatar3.3.png" alt="">
                        </div>
                        <div class="client-meta">
                            <h3>Elif Giray <span>Üreticimiz</span></h3>
                            <p class="testimonial-body">
                                " doğaya olan sevgisi ve emeğiyle, tamamen doğal ve katkısız ürünler üretmeye kendini adamış bir çiftçidir. Esmer teni ve sıcak gülümsemesiyle, organik tarımın her aşamasında titizlikle çalışarak en kaliteli ve sağlıklı köy ürünlerini sunmaktadır. Geleneksel yöntemleri modern bilinçle harmanlayan Elif’in üretimiyle sofralarınıza doğallık ve lezzet taşıyoruz! "
                            </p>
                            <div class="last-icon">
                                <i class="fas fa-quote-right"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end testimonail-section -->
