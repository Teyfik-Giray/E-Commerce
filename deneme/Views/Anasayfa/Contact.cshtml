
@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/AnasayfaLayout.cshtml";
}


<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 text-center">
                <div class="breadcrumb-text">
                    <p>7/24 Destek Alın!</p>
                    <h1>Bize Ulaşın</h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end breadcrumb section -->
<!-- contact form -->
<div class="contact-from-section mt-150 mb-150">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mb-5 mb-lg-0">
                <div class="form-title">
                    <h2>Herhangi bir sorunuz var mı?</h2>

                </div>
                <div id="form_status"></div>
                <div class="contact-form">
                    <form type="POST" id="fruitkha-contact" onSubmit="return valid_datas( this );">
                        <p>
                            <input type="text" placeholder="Name" name="name" id="name">
                            <input type="email" placeholder="Email" name="email" id="email">
                        </p>
                        <p>
                            <input type="tel" placeholder="Phone" name="phone" id="phone">
                            <input type="text" placeholder="Subject" name="subject" id="subject">
                        </p>
                        <p><textarea name="message" id="message" cols="30" rows="10" placeholder="Message"></textarea></p>
                        <input type="hidden" name="token" value="VALUE" />
                        <p><input type="submit" value="Gönder"></p>
                    </form>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="contact-form-wrap">
                    <div class="contact-form-box">
                        <h4><i class="fas fa-map"></i> Alışveriş Adresi</h4>
                        <p>53, Dikkaya <br> Çamlıhemşin, Rize. <br>Türkiye</p>
                    </div>
                    <div class="contact-form-box">
                        <h4><i class="far fa-clock"></i> Alışveriş Saati</h4>
                        <p>Pazartesi - Cuma: 08.00-21.00</p>
                    </div>
                    <div class="contact-form-box">
                        <h4><i class="fas fa-address-book"></i> İletişim</h4>
                        <p>Telefon: +90 536 720 20 20<br> Email: hemsinorganik@hotmail.com</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end contact form -->
<!-- find our location -->
<div class="find-location blue-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <p> <i class="fas fa-map-marker-alt"></i>Konumumuzu Bulun</p>
            </div>
        </div>
    </div>
</div>
<!-- end find our location -->
