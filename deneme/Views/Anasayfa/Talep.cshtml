                                        <div class="input-group-prepend">
                                            <span class="input-group-text">+90</span>
                                        </div>
                                        <input type="tel" class="form-control" id="telefon" name="telefon"
                                               pattern="[0-9]{10}"
                                               title="Lütfen 10 haneli telefon numaranızı giriniz (Örn: 5551234567)"
