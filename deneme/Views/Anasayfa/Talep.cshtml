            border-radius: 5px;
            border: 1px solid #ddd;
            padding: 5px 15px;
            margin-bottom: 15px;
        }

        .contact-form textarea.form-control {
            min-height: 150px;
        }

    .boxed-btn {
        background: #F28123;
        color: #fff;
        border: none;
        padding: 12px 30px;
        font-weight: 600;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s;
