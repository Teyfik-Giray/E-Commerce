<script>
    // Telefon numarası girişini kontrol et
    document.getElementById('telefon').addEventListener('input', function (e) {
        this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);
    });

    // Toast bildirimi göster
    function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'toast show';
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Form gönderim işlemi
    document.getElementById('talep-form').addEventListener('submit', function (e) {
        e.preventDefault();

        // E-posta adresini birleştir
        const emailPrefix = document.getElementById('email-prefix').value;
        document.getElementById('email').value = emailPrefix + '@@gmail.com';

        // Form verilerini hazırla
        const data = {
            ad: document.getElementById('ad').value,
            soyad: document.getElementById('soyad').value,
            eposta: document.getElementById('email').value,
            tel: '+90' + document.getElementById('telefon').value,
            sehir: document.getElementById('sehir').value,
            urun: document.getElementById('urun').value,
            aciklama: document.getElementById('detay').value,
            gun: document.getElementById('teslimat').value
        };

        // Sunucuya gönder
        fetch('/Anasayfa/TalepKaydet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify(data)
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showToast(result.message);
                    document.getElementById('talep-form').reset();
                } else {
                    showToast("Hata: " + result.message);
                }
            })
            .catch(error => {
                console.error('Hata:', error);
                showToast("Gönderim sırasında bir hata oluştu.");
            });
    });
</script>
