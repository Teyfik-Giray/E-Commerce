<script>
	document.addEventListener("DOMContentLoaded", function () {
    const cartButtons = document.querySelectorAll(".cart-btn");
    const toast = document.getElementById("toast");

    cartButtons.forEach(button => {
        button.addEventListener("click", function (event) {
            event.preventDefault();

            // Ürün bilgilerini al
            const product = this.closest(".single-product-item");
            const productName = product.querySelector("h3").textContent;
            const productPrice = product.querySelector(".product-price").textContent.replace("Per Kg", "").trim();
            const productImage = product.querySelector(".product-image img").src;

            // Sepetteki ürünleri al
            let cart = JSON.parse(localStorage.getItem("cart")) || [];

            // Ürün zaten sepette varsa miktarını artır
            let existingProduct = cart.find(item => item.name === productName);
            if (existingProduct) {
                existingProduct.quantity += 1;
            } else {
                cart.push({ name: productName, price: productPrice, image: productImage, quantity: 1 });
            }

            // Güncellenmiş sepeti `localStorage`'a kaydet
            localStorage.setItem("cart", JSON.stringify(cart));

            // Bildirimi göster
            toast.textContent = `"${productName}" sepete eklendi!`;
            toast.classList.add("show");

            // 3 saniye sonra bildirimi gizle ve sepete yönlendir
            setTimeout(() => {
                toast.classList.remove("show");
                window.location.href = "Cart"; // Kullanıcıyı sepete yönlendir
            }, 3000);
        });
    });
});
</script>
