@{
    ViewBag.Title = "EditUser";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container mx-auto p-8">
    <!-- Kullanıcı Düzenle Formu -->
    <div class="bg-white p-6 rounded-xl shadow-lg mb-8">
        <h2 class="text-3xl font-bold mb-6 text-gray-800">✏️ Kullanıcıyı Düzenle</h2>

        <form action="@Url.Action("EditUser", "Admin")" method="post">
            <input type="hidden" name="id" value="@Model.id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="adi" class="block text-sm font-medium text-gray-700">Adı</label>
                    <input type="text" id="adi" name="adi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" value="@Model.adi" required />
                </div>
                <div>
                    <label for="soyadi" class="block text-sm font-medium text-gray-700">Soyadı</label>
                    <input type="text" id="soyadi" name="soyadi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" value="@Model.soyadi" required />
                </div>
                <div>
                    <label for="kullanici_adi" class="block text-sm font-medium text-gray-700">Kullanıcı Adı</label>
                    <input type="text" id="kullanici_adi" name="kullanici_adi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" value="@Model.kullanici_adi" required />
                </div>
                <div>
                    <label for="sifre" class="block text-sm font-medium text-gray-700">Şifre</label>
                    <input type="password" id="sifre" name="sifre" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>
            </div>

            <div class="mt-6">
                <button type="submit" class="w-full md:w-auto bg-blue-500 text-white py-2 px-6 rounded-lg shadow-md hover:bg-blue-600 transition">
                    💾 Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
