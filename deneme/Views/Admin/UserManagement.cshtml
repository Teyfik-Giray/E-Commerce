@{
    ViewBag.Title = "UserManagement";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container mx-auto p-8">
    <!-- Yeni Kullanıcı Ekle Formu -->
    <div class="bg-white p-6 rounded-xl shadow-lg mb-8">
        <h2 class="text-3xl font-bold mb-6 text-gray-800">👥 Yeni Kullanıcı Ekle</h2>
        <form action="@Url.Action("AddUser", "Admin")" method="post" enctype="multipart/form-data">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="adi" class="block text-sm font-medium text-gray-700">Adı</label>
                    <input type="text" id="adi" name="adi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" required />
                </div>
                <div>
                    <label for="soyadi" class="block text-sm font-medium text-gray-700">Soyadı</label>
                    <input type="text" id="soyadi" name="soyadi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" required />
                </div>
                <div>
                    <label for="kullanici_adi" class="block text-sm font-medium text-gray-700">Kullanıcı Adı</label>
                    <input type="text" id="kullanici_adi" name="kullanici_adi" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" required />
                </div>
                <div>
                    <label for="sifre" class="block text-sm font-medium text-gray-700">Şifre</label>
                    <input type="password" id="sifre" name="sifre" class="mt-2 block w-full border border-gray-300 rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500" required />
                </div>
            </div>
            <div class="mt-6">
                <button type="submit" class="w-full md:w-auto bg-blue-500 text-white py-2 px-6 rounded-lg shadow-md hover:bg-blue-600 transition">
                    ➕ Kullanıcıyı Ekle
                </button>
            </div>
        </form>
    </div>
    <!-- Kullanıcı Listeleme Tablosu -->
    <div class="bg-white p-6 rounded-xl shadow-lg mb-8">
        <h2 class="text-3xl font-bold mb-6 text-gray-800">👥 Kullanıcılar</h2>
        <table class="w-full border-collapse overflow-hidden rounded-lg shadow-md">
            <thead class="bg-gray-200 text-gray-700">
                <tr>
                    <th class="py-3 px-6 text-left">Adı</th>
                    <th class="py-3 px-6 text-left">Soyadı</th>
                    <th class="py-3 px-6 text-left">Kullanıcı Adı</th>
                    <th class="py-3 px-6 text-left">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="border-b hover:bg-gray-100 transition">
                        <td class="py-3 px-6">@user.adi</td>
                        <td class="py-3 px-6">@user.soyadi</td>
                        <td class="py-3 px-6">@user.kullanici_adi</td>
                        <td class="py-3 px-6">
                            <a href="@Url.Action("EditUser", "Admin", new { id = user.id })" class="bg-yellow-500 text-white py-1 px-3 rounded shadow hover:bg-yellow-600 transition">✏️ Düzenle</a>
                            <a href="@Url.Action("DeleteUser", "Admin", new { id = user.id })" class="bg-red-500 text-white py-1 px-3 rounded shadow hover:bg-red-600 transition ml-2">🗑 Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
