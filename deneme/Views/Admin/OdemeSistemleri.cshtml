@{
    ViewBag.Title = "OdemeSistemleri";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-bold text-gray-800">Ödeme Metodları</h1>
        <div class="text-gray-500">6 ödeme metodu mevcut</div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold text-gray-700">Türkiye'deki Devlet Bankaları</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Ziraat Bankası -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/ziraatlogo.png" alt="Ziraat Bankası" class="h-10 mr-3">
                    <h3 class="font-semibold">Ziraat Bankası</h3>
                </div>
                <p class="text-gray-600 mb-4">Türkiye'nin en büyük devlet bankası ile entegrasyon</p>
                <button onclick="showIntegrationForm('ziraat')" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                    Entegre Et
                </button>
            </div>

            <!-- Halkbank -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/halkbanklogo.jpeg" alt="Halkbank" class="h-10 mr-3">
                    <h3 class="font-semibold">Halkbank</h3>
                </div>
                <p class="text-gray-600 mb-4">Devlet destekli ödeme çözümleri</p>
                <button onclick="showIntegrationForm('halkbank')" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                    Entegre Et
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold text-gray-700">Özel Bankalar</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Akbank -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/akbanklogo.png" alt="Akbank" class="h-10 mr-3">
                    <h3 class="font-semibold">Akbank</h3>
                </div>
                <p class="text-gray-600 mb-4">Hızlı ve güvenli ödeme çözümleri</p>
                <button onclick="showIntegrationForm('akbank')" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                    Entegre Et
                </button>
            </div>

            <!-- İş Bankası -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/isbankasılogo.png" alt="İş Bankası" class="h-10 mr-3">
                    <h3 class="font-semibold">İş Bankası</h3>
                </div>
                <p class="text-gray-600 mb-4">Türkiye'nin lider özel bankası</p>
                <button onclick="showIntegrationForm('isbank')" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                    Entegre Et
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold text-gray-700">Sanal POS Sağlayıcılar</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Iyzico -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/iyzicologo.jpeg" alt="Iyzico" class="h-10 mr-3">
                    <h3 class="font-semibold">Iyzico</h3>
                </div>
                <p class="text-gray-600 mb-4">Online ödeme almanın en kolay yolu</p>
                <div class="flex space-x-2">
                    <a href="https://www.iyzico.com" target="_blank" class="w-1/2 bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition text-center">
                        Detaylar
                    </a>
                    <button onclick="showIntegrationForm('iyzico')" class="w-1/2 bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                        Entegre Et
                    </button>
                </div>
            </div>

            <!-- PayTR -->
            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
                <div class="flex items-center mb-4">
                    <img src="~/assets/img/logo/paytrlogo.jpeg" alt="PayTR" class="h-10 mr-3">
                    <h3 class="font-semibold">PayTR</h3>
                </div>
                <p class="text-gray-600 mb-4">Hızlı ve güvenli ödeme altyapısı</p>
                <div class="flex space-x-2">
                    <a href="https://www.paytr.com" target="_blank" class="w-1/2 bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition text-center">
                        Detaylar
                    </a>
                    <button onclick="showIntegrationForm('paytr')" class="w-1/2 bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
                        Entegre Et
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Entegrasyon Formu Modal -->
<div id="integrationModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white rounded-lg p-6 w-full max-w-md">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-semibold" id="modalTitle">Entegrasyon Ayarları</h3>
            <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="integrationForm">
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">API Anahtarı</label>
                <input type="text" class="w-full px-3 py-2 border rounded" placeholder="API anahtarınızı girin" required>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Gizli Anahtar</label>
                <input type="password" class="w-full px-3 py-2 border rounded" placeholder="Gizli anahtarınızı girin" required>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Mağaza Kodu</label>
                <input type="text" class="w-full px-3 py-2 border rounded" placeholder="Mağaza kodunuzu girin">
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="closeModal()" class="px-4 py-2 border rounded hover:bg-gray-100 transition">
                    İptal
                </button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
                    Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function showIntegrationForm(provider) {
        const modal = document.getElementById('integrationModal');
        const title = document.getElementById('modalTitle');

        // Sağlayıcıya göre başlık güncelleme
        const providerNames = {
            'ziraat': 'Ziraat Bankası',
            'halkbank': 'Halkbank',
            'akbank': 'Akbank',
            'isbank': 'İş Bankası',
            'iyzico': 'Iyzico',
            'paytr': 'PayTR'
        };

        title.textContent = `${providerNames[provider]} Entegrasyonu`;
        modal.classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('integrationModal').classList.add('hidden');
    }

    // Form gönderimini işleme
    document.getElementById('integrationForm').addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Entegrasyon ayarları kaydedildi!');
        closeModal();
    });
</script>