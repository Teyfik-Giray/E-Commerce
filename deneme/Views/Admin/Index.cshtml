@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<!-- Main Content -->
<main class="flex-1 p-6">
   

    <!-- Stats Cards -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Total Visits Card -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all">
            <h3 class="text-gray-600 text-sm">Total Visits</h3>
            <div class="flex items-center">
                <p class="text-3xl font-bold text-green-500">659</p>
                <i class="fas fa-chart-line text-green-500 ml-3"></i>
            </div>
        </div>

        <!-- Total Page Views Card -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all">
            <h3 class="text-gray-600 text-sm">Total Page Views</h3>
            <div class="flex items-center">
                <p class="text-3xl font-bold text-blue-500">869</p>
                <i class="fas fa-eye text-blue-500 ml-3"></i>
            </div>
        </div>

        <!-- Unique Visitors Card -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-all">
            <h3 class="text-gray-600 text-sm">Unique Visitors</h3>
            <div class="flex items-center">
                <p class="text-3xl font-bold text-purple-500">911</p>
                <i class="fas fa-users text-purple-500 ml-3"></i>
            </div>
        </div>
    </section>

    <!-- Chart Section -->
    <section class="mt-6 bg-white p-6 rounded-lg shadow-md">
        <h3 class="text-xl font-bold mb-4">Ürün Yıllık Satışları</h3>
        <canvas id="salesChart"></canvas>
    </section>
</main>
