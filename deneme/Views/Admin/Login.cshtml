@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
</head>
<body class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="w-full max-w-sm p-6 bg-white rounded-2xl shadow-xl">
        <h2 class="text-2xl font-bold text-center">Welcome</h2>
        <div class="flex justify-center my-4">
            <div class="flex items-center justify-center w-12 h-12 bg-gray-800 text-white text-xl rounded-lg">A</div>
        </div>
        <form method="post" action="/Account/Login" onsubmit="redirectToIndex(event)">
            <div class="mb-4">
                <label class="block text-gray-600 text-sm mb-1">Email</label>
                <input type="email" name="Email" class="w-full p-2 border-b border-gray-300 focus:outline-none" placeholder="Enter your email" required />
            </div>
            <div class="mb-4 relative">
                <label class="block text-gray-600 text-sm mb-1">Password</label>
                <input id="password" type="password" name="Password" class="w-full p-2 border-b border-gray-300 focus:outline-none" placeholder="Enter your password" required />
                <button type="button" class="absolute right-2 top-9" onclick="togglePassword()">
                    <span id="eyeIcon">👁</span>
                </button>
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-blue-400 to-purple-500 text-white py-2 rounded-lg">LOGIN</button>
        </form>
        <p class="text-center text-sm text-gray-600 mt-4">
            Don’t have an account? <a href="/Account/Register" class="text-blue-500">Sign Up</a>
        </p>
    </div>

    <script>
        function togglePassword() {
            var passwordField = document.getElementById("password");
            var eyeIcon = document.getElementById("eyeIcon");
            if (passwordField.type === "password") {
                passwordField.type = "text";
                eyeIcon.textContent = "🙈";
            } else {
                passwordField.type = "password";
                eyeIcon.textContent = "👁";
            }
        }

        function redirectToIndex(event) {
            event.preventDefault(); // Formun varsayılan gönderimini engelle
            window.location.href = "/Admin/Index"; // Index sayfasına yönlendir
        }
    </script>
</body>
</html>
