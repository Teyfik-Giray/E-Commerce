    <style>
        /* Toast bildirimi için stil */
        .toast {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #4CAF50;
            color: white;
            padding: 15px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            opacity: 0;
            transform: translateX(100%);
            transition: opacity 0.5s, transform 0.5s;
            font-size: 16px;
            z-index: 9999;
        }

            .toast.show {
                opacity: 1;
                transform: translateX(0);
            }
    </style>


</head>
